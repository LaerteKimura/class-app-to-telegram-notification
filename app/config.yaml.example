classapp:
  login_url: https://classapp.com.br/login
  email: your@email.com
  password: yourpassword
  children:
    - name: Child One
      messages_url: https://classapp.com.br/entities/ENTITY_ID_1/messages
    - name: Child Two
      messages_url: https://classapp.com.br/entities/ENTITY_ID_2/messages

telegram:
  # 1. Message @BotFather on Telegram → /newbot → follow steps → copy the token here
  bot_token: "123456789:AAABBBCCC..."
  # 2. Start a chat with your bot, then run: python main.py get-chat-id
  #    It will print your chat_id automatically.
  chat_id: "000000000"

schedule:
  # How often to check, in hours. 12 = twice a day. Min: 0.5 (30 minutes)
  interval_hours: 4

filters:
  # Leave empty to receive ALL messages.
  # Add keywords to only receive messages whose subject contains any of them (case-insensitive).
  # Example: keywords: ["prova", "reunião", "aviso", "recado"]
  keywords: []
